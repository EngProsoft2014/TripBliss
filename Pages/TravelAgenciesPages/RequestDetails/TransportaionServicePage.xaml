                            </VerticalStackLayout>
                            <VerticalStackLayout HorizontalOptions="FillAndExpand">
                                <Label Text="{Static res:AppResources.lblBrand_TranServices}" FontAutoScalingEnabled="False" TextColor="#2fa562" FontSize="14" Margin="0,15,0,5"></Label>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="Gray" HeightRequest="40">
                                    <VerticalStackLayout>
                                        <Picker x:Name="BrandPick" TextColor="Black" FontSize="14" FontAutoScalingEnabled="False" ItemsSource="{Binding CarBrands}" ItemDisplayBinding="{Binding BrandName}"
                                        SelectedItem="{Binding SelectrdBrand}" SelectedIndexChanged="BrandPick_SelectedIndexChanged">
                                            <Picker.Triggers>
                                                <DataTrigger TargetType="Picker" Binding="{Binding ServiceModdel.AcceptAgen}" Value="True">
                                                    <Setter Property="IsVisible" Value="False"></Setter>
                                                </DataTrigger>
                                            </Picker.Triggers>
                                        </Picker>
                                        <Label Text="{Binding ServiceModdel.RequestTravelAgencyTransport.BrandNameLang}" TextColor="Black" FontSize="14"
                                                IsVisible="False" Margin="10">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding ServiceModdel.AcceptAgen}" Value="True">
                                                    <Setter Property="IsVisible" Value="True"></Setter>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>

                                </Border>

                                <!--<Label Text="{Static res:AppResources.lblModel_TranService}" FontAutoScalingEnabled="False" TextColor="#2fa562" FontSize="14" Margin="0,15,0,5"></Label>
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="Gray" HeightRequest="40">
